# Copy to .env for local development. Never commit real values.

UNMASK_ENV=development
DATABASE_URL=postgresql://unmask:unmask@localhost:5432/unmask
REDIS_URL=redis://localhost:6379/0

# Session cookie signing key (python -c "import secrets; print(secrets.token_urlsafe(48))")
SECRET_KEY=

# Encryption keys for sensitive fields. Generate with: python -m app.cli gen-keys
# In production these belong in a secret store separate from the database
# (see README > Key management) — never on the Postgres service.
UNMASK_DATA_KEYS=
UNMASK_INDEX_KEY=

# Bootstrap admin, created on first start only if no users exist.
UNMASK_ADMIN_EMAIL=
UNMASK_ADMIN_PASSWORD=

PUBLIC_BASE_URL=http://localhost:8000
UNMASK_ALLOW_INDEXING=true

# Directory containing tool binaries (scripts/install-tools.sh puts them in
# $TOOLS_DIR/bin). Defaults to $PATH.
UNMASK_TOOLS_BIN=

# "inline" runs scans in the web process (simple local dev); "rq" queues them
# in Redis for `python -m app.worker` (production default in the Docker image).
UNMASK_QUEUE=inline
# web | worker — which process scripts/start.sh launches.
UNMASK_ROLE=web

# Tool settings
UNMASK_MAIGRET_TOP_SITES=500
UNMASK_HARVESTER_SOURCES=crtsh,hackertarget,rapiddns,otx,certspotter,urlscan
UNMASK_SPIDERFOOT_USE_CASE=passive
# Breach APIs for h8mail, e.g. hibp=KEY,snusbase_token=KEY. Without at least
# one, h8mail is shown as "Not configured" and never runs.
UNMASK_H8MAIL_KEYS=

# Correlation pass 2 (local embeddings). Must already be on disk (the Docker
# image bakes it in); set to empty to run pass 1 only.
UNMASK_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
UNMASK_EMBEDDING_CACHE=
UNMASK_EMBEDDING_THRESHOLD=0.8

# Automatic pivots
UNMASK_PIVOT_MAX_DEPTH=2
UNMASK_PIVOT_BUDGET=20
UNMASK_PIVOT_EMAIL_PROVIDERS=gmail.com,outlook.com,yahoo.com,proton.me

# Scheduler (watch mode, retention purges, health checks)
UNMASK_SCHEDULER=true
UNMASK_SCHEDULER_INTERVAL=300
UNMASK_WATCH_MAX_PER_TICK=3
UNMASK_HEALTHCHECK_HOURS=24
# Slack/Discord/Teams-compatible webhook for operational alerts (no case data is sent)
UNMASK_ALERT_WEBHOOK_URL=
