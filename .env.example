# Copy to .env for local development. Never commit real values.

UNMASK_ENV=development
DATABASE_URL=postgresql://unmask:unmask@localhost:5432/unmask
REDIS_URL=redis://localhost:6379/0

# Session cookie signing key (python -c "import secrets; print(secrets.token_urlsafe(48))")
SECRET_KEY=

# Encryption keys for sensitive fields. Generate with: python -m app.cli gen-keys
# In production these belong in a secret store separate from the database
# (see README > Key management) — never on the Postgres service.
UNMASK_DATA_KEYS=
UNMASK_INDEX_KEY=

# Bootstrap admin, created on first start only if no users exist.
UNMASK_ADMIN_EMAIL=
UNMASK_ADMIN_PASSWORD=

PUBLIC_BASE_URL=http://localhost:8000
UNMASK_ALLOW_INDEXING=true

# Directory containing tool binaries (sherlock, ...). Defaults to $PATH.
UNMASK_TOOLS_BIN=
