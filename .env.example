# Copy to .env for local development. Never commit real values.

UNMASK_ENV=development
DATABASE_URL=postgresql://unmask:unmask@localhost:5432/unmask
REDIS_URL=redis://localhost:6379/0

# Session cookie signing key (python -c "import secrets; print(secrets.token_urlsafe(48))")
SECRET_KEY=

# Encryption keys for sensitive fields. Generate with: python -m app.cli gen-keys
# In production these belong in a secret store separate from the database
# (see README > Key management) — never on the Postgres service.
UNMASK_DATA_KEYS=
UNMASK_INDEX_KEY=

# Bootstrap admin, created on first start only if no users exist.
UNMASK_ADMIN_EMAIL=
UNMASK_ADMIN_PASSWORD=

PUBLIC_BASE_URL=http://localhost:8000
UNMASK_ALLOW_INDEXING=true

# Directory containing tool binaries (scripts/install-tools.sh puts them in
# $TOOLS_DIR/bin). Defaults to $PATH.
UNMASK_TOOLS_BIN=

# "inline" runs scans in the web process (simple local dev); "rq" queues them
# in Redis for `python -m app.worker` (production default in the Docker image).
UNMASK_QUEUE=inline
# web | worker — which process scripts/start.sh launches.
UNMASK_ROLE=web

# Tool settings
# focused: ~120 reliable sites for Sherlock and Maigret (fast, few false positives);
# all: every site the tools know. UNMASK_MAIGRET_TOP_SITES applies to "all" only.
UNMASK_USERNAME_SITES=focused
UNMASK_MAIGRET_TOP_SITES=200
UNMASK_HARVESTER_SOURCES=crtsh,hackertarget,rapiddns,otx,certspotter,urlscan
UNMASK_SPIDERFOOT_USE_CASE=passive
# Breach APIs for h8mail, e.g. hibp=KEY,snusbase_token=KEY. Without at least
# one, h8mail is shown as "Not configured" and never runs.
UNMASK_H8MAIL_KEYS=
# Web search: targeted queries (exact value, with context tags, social and
# developer sites, documents). Set a key for one provider; the first one found
# is used in this order unless UNMASK_SEARCH_PROVIDER names one.
#   serper  (Google results)  https://serper.dev
#   serpapi (Google results)  https://serpapi.com
#   google  (Programmable Search) needs both key and engine id (cx)
#   brave                     https://brave.com/search/api/
UNMASK_SEARCH_PROVIDER=
UNMASK_SERPER_KEY=
UNMASK_SERPAPI_KEY=
UNMASK_GOOGLE_API_KEY=
UNMASK_GOOGLE_CX=
UNMASK_BRAVE_API_KEY=
UNMASK_SEARCH_MAX_QUERIES=8
UNMASK_SEARCH_RESULTS=10

# Account verification: each account hit's profile page is fetched once and
# checked before it is shown. Rejected "not found" pages are dropped; pages that
# can't be judged (bot or login walls) are kept but hidden by default.
UNMASK_VERIFY_ACCOUNTS=true
UNMASK_VERIFY_TIMEOUT=8
UNMASK_VERIFY_CONCURRENCY=12
UNMASK_VERIFY_MAX=250

# Correlation pass 2 (local embeddings). Must already be on disk (the Docker
# image bakes it in); set to empty to run pass 1 only.
UNMASK_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
UNMASK_EMBEDDING_CACHE=
UNMASK_EMBEDDING_THRESHOLD=0.8

# Automatic pivots
UNMASK_PIVOT_MAX_DEPTH=2
UNMASK_PIVOT_BUDGET=20
UNMASK_PIVOT_EMAIL_PROVIDERS=gmail.com,outlook.com,yahoo.com,proton.me

# Scheduler (watch mode, retention purges, health checks)
UNMASK_SCHEDULER=true
UNMASK_SCHEDULER_INTERVAL=300
UNMASK_WATCH_MAX_PER_TICK=3
UNMASK_HEALTHCHECK_HOURS=24
# Slack/Discord/Teams-compatible webhook for operational alerts (no case data is sent)
UNMASK_ALERT_WEBHOOK_URL=

# Legal pages (/terms, /privacy, /acceptable-use, /trust). The operator is the
# party users contract with. Have the pages reviewed by a lawyer before launch.
UNMASK_OPERATOR_NAME=
UNMASK_LEGAL_CONTACT=
UNMASK_SECURITY_CONTACT=
UNMASK_GOVERNING_LAW=Singapore

# Email notifications (optional). Messages say what happened and link back into
# the app; they never contain case names, targets or findings.
UNMASK_SMTP_HOST=
UNMASK_SMTP_PORT=587
UNMASK_SMTP_USER=
UNMASK_SMTP_PASSWORD=
UNMASK_SMTP_FROM=

# Outbound proxy for tools that sites block from cloud IPs (Holehe especially).
# A residential proxy works best: http://user:pass@host:port (or socks5://...).
# The URL reaches tools through the environment, never on a command line.
# UNMASK_PROXY_TOOLS: comma-separated tool names, "verify" for the profile-page
# check, or "all".
UNMASK_PROXY_URL=
UNMASK_PROXY_TOOLS=holehe,sherlock,maigret,verify
